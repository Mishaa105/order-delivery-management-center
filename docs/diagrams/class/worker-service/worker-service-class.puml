@startuml
skinparam classAttributeIconSize 0

title Диаграмма классов — Микросервис прибора (order-worker-service)

'Это будет record
class Order 
{
    - id: Long
    - sourceId: String
    - timestamp: LocalDateTime
    - data: String
}

enum OrderStatus 
{
    COMPLETED
    FAILED
}

class WorkerDispatcher
{
    + processBatch(batch: List<Order>): void
    + selectFreeWorker(): Worker
}

class Worker
{
    - workerId : long
    + processOrder(order: Order): OrderStatus
}

class OrderBatchKafkaConsumer 
{
    - workerDispatcher: WorkerDispatcher
    + consume(batch: List<Order>): void
}

OrderBatchKafkaConsumer --> WorkerDispatcher : передает пакет на обработку
WorkerDispatcher --> Worker : Выбирает прибор и передает ему Order
Worker ..> OrderStatus : определяет статус
Worker ..> Order : обрабатывает заявки в пакете
OrderBatchKafkaConsumer ..> Order : десериализует список

@enduml